                "--vocab-file",
                "/mount/gpt2-vocab.json",
                "--merge-file",
                "/mount/gpt2-merges.txt",
                "--make-vocab-size-divisible-by",
                "1024",
                "--split",
                "969,30,1",
                // --- 来自 COMPUTE_ARGUMENTS ---
                "--fp16",
                "--DDP-impl",
                "local",
                "--moe-expert-model-parallelism",
                "--no-async-tensor-model-parallel-allreduce",
                // "--use-flash-attn",
                // --- 来自 CHECKPOINT_ARGUMENTS ---
                "--save-interval",
                "2000",
                // !! 注意 !!
                // 你的 EXP_DIR 是 $1，这里必须手动指定一个值
