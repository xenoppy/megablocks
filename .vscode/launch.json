                "20000",
                "--lr",
                "0.0006",
                "--min-lr",
                "0.00006",
                "--lr-decay-style",
                "cosine",
                "--lr-warmup-fraction",
                "0.01",
                "--clip-grad",
                "1.0",
                "--init-method-std",
                "0.01",
                "--optimizer",
                "adam",
                // --- 来自 DATA_ARGUMENTS ---
                "--data-path",
